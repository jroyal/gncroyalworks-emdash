---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PieceCard from "../components/PieceCard.astro";
import { ETSY_SHOP_URL, getTermLabels } from "../lib/site";

const [{ entry: homePage, cacheHint: pageCacheHint }, featuredResult] =
	await Promise.all([
		getEmDashEntry("pages", "home"),
		getEmDashCollection("pieces", {
			orderBy: { published_at: "desc" },
			limit: 100,
		}),
	]);

function getFeaturedOrder(piece: (typeof featuredResult.entries)[number]) {
	const order = piece.data.featured_order;
	return typeof order === "number" && Number.isFinite(order)
		? order
		: null;
}

let featuredPieces = featuredResult.entries
	.filter((piece) => piece.data.featured)
	.sort((a, b) => {
		const aOrder = getFeaturedOrder(a);
		const bOrder = getFeaturedOrder(b);
		if (aOrder === null && bOrder === null) return 0;
		if (aOrder === null) return 1;
		if (bOrder === null) return -1;
		return aOrder - bOrder;
	})
	.slice(0, 4);
let piecesCacheHint = featuredResult.cacheHint;

if (featuredPieces.length === 0) {
	const latestResult = await getEmDashCollection("pieces", {
		orderBy: { published_at: "desc" },
		limit: 4,
	});
	featuredPieces = latestResult.entries;
	piecesCacheHint = latestResult.cacheHint;
}

if (Astro.cache?.enabled) {
	Astro.cache.set(pageCacheHint);
	Astro.cache.set(piecesCacheHint);
}
---

<Base>
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Handmade in Katy, Texas</p>
			<h1 class="hero-title" {...homePage?.edit?.title}>
				{homePage?.data?.title || "Leatherwork meant to be used."}
			</h1>
			<div class="hero-intro" {...homePage?.edit?.content}>
				{
					homePage?.data?.content ? (
						<PortableText value={homePage.data.content} />
					) : (
						<p>
							Browse finished handmade leather pieces, then visit Etsy to ask
							about availability or something similar.
						</p>
					)
				}
			</div>
			<div class="cta-row">
				<a class="button" href="/finished-work">Browse Finished Work</a>
				<a
					class="button secondary"
					href={ETSY_SHOP_URL}
					target="_blank"
					rel="noopener noreferrer"
				>
					Visit the Etsy Shop
				</a>
			</div>
		</div>
	</section>

	{
		featuredPieces.length > 0 ? (
			<section class="featured">
				<header class="section-header">
					<p class="eyebrow">Featured Pieces</p>
					<div class="section-title-row">
						<h2 class="section-title">Finished work from the shop</h2>
						<a href="/finished-work" class="section-link">
							View all finished work
						</a>
					</div>
				</header>
				<div class="pieces-grid">
					{featuredPieces.map((piece) => (
						<PieceCard
							title={piece.data.title ?? "Untitled"}
							summary={piece.data.summary}
							featuredImage={piece.data.featured_image ?? ""}
							href={`/finished-work/${piece.id}`}
							categories={getTermLabels(piece.data.terms?.category)}
							tags={getTermLabels(piece.data.terms?.tag)}
						/>
					))}
				</div>
			</section>
		) : (
			<section class="empty-state">
				<h2>No finished pieces yet</h2>
				<p>Add the first finished piece in the admin panel.</p>
				<a href="/_emdash/admin/content/pieces/new" class="button">
					Add a finished piece
				</a>
			</section>
		)
	}
</Base>

<style>
	.hero,
	.featured,
	.empty-state {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding-inline: var(--spacing-lg);
	}

	.hero {
		padding-block: var(--spacing-4xl) var(--spacing-3xl);
	}

	.hero-copy {
		max-width: 820px;
	}

	.eyebrow {
		margin-bottom: var(--spacing-sm);
		color: var(--color-brand);
		font-size: var(--font-size-xs);
		font-weight: 800;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.hero-title {
		max-width: 780px;
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
	}

	.hero-intro {
		max-width: 680px;
		margin-top: var(--spacing-lg);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
		margin-top: var(--spacing-xl);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: var(--spacing-sm) var(--spacing-lg);
		border: 1px solid var(--color-text);
		border-radius: var(--radius);
		background: var(--color-text);
		color: var(--color-bg);
		font-size: var(--font-size-sm);
		font-weight: 800;
		text-decoration: none;
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.button:hover {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: var(--color-on-brand);
	}

	.button.secondary {
		background: transparent;
		color: var(--color-text);
	}

	.featured {
		padding-bottom: var(--spacing-4xl);
	}

	.section-header {
		margin-bottom: var(--spacing-2xl);
		padding-bottom: var(--spacing-md);
		border-bottom: 1px solid var(--color-border);
	}

	.section-title-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-lg);
	}

	.section-title {
		font-size: var(--font-size-2xl);
	}

	.section-link {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: none;
	}

	.section-link:hover {
		color: var(--color-brand);
	}

	.pieces-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-2xl);
	}

	.empty-state {
		padding-block: var(--spacing-4xl);
		text-align: center;
	}

	.empty-state p {
		margin-block: var(--spacing-sm) var(--spacing-lg);
		color: var(--color-muted);
	}

	@media (max-width: 760px) {
		.hero {
			padding-block: var(--spacing-xl) var(--spacing-3xl);
		}

		.hero-title {
			font-size: 2.35rem;
		}

		.hero-intro {
			font-size: var(--font-size-base);
		}

		.cta-row {
			flex-wrap: nowrap;
			gap: var(--spacing-sm);
		}

		.button {
			flex: 1 1 0;
			min-width: 0;
			padding-inline: var(--spacing-sm);
			font-size: var(--font-size-xs);
			text-align: center;
		}

		.section-title-row {
			align-items: flex-start;
			flex-direction: column;
			gap: var(--spacing-sm);
		}

		.section-title {
			font-size: var(--font-size-xl);
		}

		.pieces-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
