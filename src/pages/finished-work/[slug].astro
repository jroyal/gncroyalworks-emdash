---
import {
	decodeSlug,
	getEmDashCollection,
	getEmDashEntry,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PieceCard from "../../components/PieceCard.astro";
import { ETSY_SHOP_URL, getPrimaryTermLabel, getTermLabels } from "../../lib/site";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: piece, cacheHint: pieceCacheHint } = await getEmDashEntry(
	"pieces",
	slug,
);

if (!piece) {
	return Astro.redirect("/404");
}

const [
	{ entry: detailPage, cacheHint: detailPageCacheHint },
	{ entries: relatedPieces, cacheHint: relatedCacheHint },
] = await Promise.all([
	getEmDashEntry("pages", "piece-detail"),
	getEmDashCollection("pieces", {
		orderBy: { published_at: "desc" },
		limit: 4,
	}),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(pieceCacheHint);
	Astro.cache.set(detailPageCacheHint);
	Astro.cache.set(relatedCacheHint);
}

const otherPieces = relatedPieces
	.filter((relatedPiece) => relatedPiece.id !== piece.id)
	.slice(0, 3);
const categoryLabel = getPrimaryTermLabel(piece.data.terms?.category);
const tagLabels = getTermLabels(piece.data.terms?.tag);
const factRows = [
	["Materials", piece.data.materials],
	["Color", piece.data.color],
	["Dimensions", piece.data.dimensions],
].filter(([, value]) => Boolean(value));
const relatedEyebrow =
	detailPage?.data.related_eyebrow?.trim() || "More Finished Work";
const relatedHeading =
	detailPage?.data.related_heading?.trim() || "Other pieces from the shop";

function getImageSrc(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	return typeof image.src === "string" ? image.src : undefined;
}
---

<Base
	title={piece.data.title}
	description={piece.data.summary}
	image={getImageSrc(piece.data.featured_image)}
	type="article"
	content={{ collection: "pieces", id: piece.data.id, slug: piece.id }}
>
	<article class="piece-detail">
		<div class="piece-media" {...piece.edit.featured_image}>
			{piece.data.featured_image && <Image image={piece.data.featured_image} />}
		</div>

		<div class="piece-copy">
			{categoryLabel && <p class="eyebrow">{categoryLabel}</p>}
			<h1 {...piece.edit.title}>{piece.data.title}</h1>
			{
				piece.data.summary && (
					<p class="summary" {...piece.edit.summary}>
						{piece.data.summary}
					</p>
				)
			}

			<div class="cta-row">
				<a
					class="button"
					href={ETSY_SHOP_URL}
					target="_blank"
					rel="noopener noreferrer"
				>
					Ask on Etsy
				</a>
				<a class="button secondary" href="/finished-work">
					Back to Finished Work
				</a>
			</div>

			{
				factRows.length > 0 && (
					<dl class="fact-list">
						{factRows.map(([label, value]) => (
							<div>
								<dt>{label}</dt>
								<dd>{value}</dd>
							</div>
						))}
					</dl>
				)
			}

			{
				tagLabels.length > 0 && (
					<div class="tag-list" aria-label="Piece tags">
						{tagLabels.map((tag) => (
							<span>{tag}</span>
						))}
					</div>
				)
			}

		</div>
	</article>

	{
		otherPieces.length > 0 && (
			<section class="more-pieces">
				<header class="more-header">
					<p class="eyebrow" {...detailPage?.edit?.related_eyebrow}>
						{relatedEyebrow}
					</p>
					<h2 {...detailPage?.edit?.related_heading}>{relatedHeading}</h2>
				</header>
				<div class="more-grid">
					{otherPieces.map((relatedPiece) => (
						<PieceCard
							title={relatedPiece.data.title ?? "Untitled"}
							summary={relatedPiece.data.summary}
							featuredImage={relatedPiece.data.featured_image ?? ""}
							href={`/finished-work/${relatedPiece.id}`}
							categories={getTermLabels(relatedPiece.data.terms?.category)}
							tags={getTermLabels(relatedPiece.data.terms?.tag)}
						/>
					))}
				</div>
			</section>
		)
	}
</Base>

<style>
	.piece-detail,
	.more-pieces {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding-inline: var(--spacing-lg);
	}

	.piece-detail {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
		gap: var(--spacing-3xl);
		padding-block: var(--spacing-3xl) var(--spacing-4xl);
		align-items: start;
	}

	.piece-media {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.piece-media :global(img) {
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.piece-copy {
		display: grid;
		gap: var(--spacing-lg);
	}

	.eyebrow {
		color: var(--color-brand);
		font-size: var(--font-size-xs);
		font-weight: 800;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.piece-copy h1 {
		font-size: var(--font-size-4xl);
		line-height: var(--leading-tight);
	}

	.summary {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: var(--spacing-sm) var(--spacing-lg);
		border: 1px solid var(--color-text);
		border-radius: var(--radius);
		background: var(--color-text);
		color: var(--color-bg);
		font-size: var(--font-size-sm);
		font-weight: 800;
		text-decoration: none;
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.button:hover {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: var(--color-on-brand);
	}

	.button.secondary {
		background: transparent;
		color: var(--color-text);
	}

	.fact-list {
		display: grid;
		gap: var(--spacing-md);
		padding: var(--spacing-lg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.fact-list div {
		display: grid;
		gap: var(--spacing-xs);
	}

	.fact-list dt {
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 800;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.fact-list dd {
		color: var(--color-text);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
	}

	.tag-list span {
		padding: var(--spacing-xs) var(--spacing-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.more-pieces {
		padding-bottom: var(--spacing-4xl);
	}

	.more-header {
		margin-bottom: var(--spacing-xl);
		padding-top: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}

	.more-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-xl);
	}

	@media (max-width: 900px) {
		.piece-detail {
			grid-template-columns: 1fr;
		}

		.more-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.piece-copy h1 {
			font-size: var(--font-size-3xl);
		}

		.more-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
