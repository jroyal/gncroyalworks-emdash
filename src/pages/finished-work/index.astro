---
export const prerender = false;

import {
	getEmDashCollection,
	getEmDashEntry,
	getTaxonomyTerms,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PieceCard from "../../components/PieceCard.astro";
import { ETSY_SHOP_URL, flattenTerms, getTermLabels } from "../../lib/site";

const requestedCategory = Astro.url.searchParams.get("category");

const [
	{ entry: page, cacheHint: pageCacheHint },
	categoryTree,
] = await Promise.all([
	getEmDashEntry("pages", "finished-work"),
	getTaxonomyTerms("category"),
]);

const categories = flattenTerms(categoryTree);
const activeCategory = categories.find(
	(category) => category.slug === requestedCategory,
);

const { entries: pieces, cacheHint: piecesCacheHint } =
	await getEmDashCollection("pieces", {
		orderBy: { published_at: "desc" },
		...(activeCategory ? { where: { category: activeCategory.slug } } : {}),
	});

if (Astro.cache?.enabled) {
	Astro.cache.set(pageCacheHint);
	Astro.cache.set(piecesCacheHint);
}

const activeCategoryLabel = activeCategory?.label;
---

<Base
	title={activeCategoryLabel ? `${activeCategoryLabel} — Finished Work` : "Finished Work"}
	description="Browse finished handmade leather pieces from GNCRoyalWorks."
>
	<section class="gallery-header">
		<p class="eyebrow">Gallery</p>
		<h1 {...page?.edit?.title}>{page?.data?.title || "Finished work"}</h1>
		<div class="gallery-intro" {...page?.edit?.content}>
			{
				page?.data?.content ? (
					<PortableText value={page.data.content} />
				) : (
					<p>
						Browse finished pieces, then visit Etsy to ask about availability
						or something similar.
					</p>
				)
			}
		</div>

		{
			categories.length > 0 && (
				<nav class="category-filters" aria-label="Filter finished work by category">
					<a
						href="/finished-work"
						class:list={["category-filter", { active: !activeCategory }]}
					>
						All
					</a>
					{categories.map((category) => (
						<a
							href={`/finished-work?category=${category.slug}`}
							class:list={[
								"category-filter",
								{ active: activeCategory?.slug === category.slug },
							]}
						>
							{category.label}
						</a>
					))}
				</nav>
			)
		}
	</section>

	{
		pieces.length > 0 ? (
			<section class="pieces">
				<div class="pieces-grid">
					{pieces.map((piece) => (
						<PieceCard
							title={piece.data.title ?? "Untitled"}
							summary={piece.data.summary}
							featuredImage={piece.data.featured_image ?? ""}
							href={`/finished-work/${piece.id}`}
							categories={getTermLabels(piece.data.terms?.category)}
							tags={getTermLabels(piece.data.terms?.tag)}
						/>
					))}
				</div>
				<div class="gallery-cta">
					<a
						href={ETSY_SHOP_URL}
						class="button secondary"
						target="_blank"
						rel="noopener noreferrer"
					>
						Visit the Etsy Shop
					</a>
				</div>
			</section>
		) : (
			<section class="empty-state">
				{activeCategory ? (
					<>
						<p>No finished pieces found in this category.</p>
						<a href="/finished-work" class="button">
							View all finished work
						</a>
					</>
				) : (
					<>
						<p>No finished pieces yet. Add the first one in the admin panel.</p>
						<a href="/_emdash/admin/content/pieces/new" class="button">
							Add a finished piece
						</a>
					</>
				)}
			</section>
		)
	}
</Base>

<style>
	.gallery-header,
	.pieces,
	.empty-state {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding-inline: var(--spacing-lg);
	}

	.gallery-header {
		padding-block: var(--spacing-3xl) var(--spacing-2xl);
	}

	.eyebrow {
		margin-bottom: var(--spacing-sm);
		color: var(--color-brand);
		font-size: var(--font-size-xs);
		font-weight: 800;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.gallery-header h1 {
		max-width: 760px;
		font-size: var(--font-size-4xl);
		line-height: var(--leading-tight);
	}

	.gallery-intro {
		max-width: 720px;
		margin-top: var(--spacing-lg);
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.category-filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-xl);
	}

	.category-filter {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: var(--spacing-xs) var(--spacing-md);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		text-decoration: none;
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.category-filter:hover,
	.category-filter.active {
		border-color: var(--color-text);
		color: var(--color-text);
	}

	.category-filter.active {
		background: var(--color-surface);
	}

	.pieces {
		padding-bottom: var(--spacing-4xl);
	}

	.pieces-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-xl);
	}

	.gallery-cta {
		margin-top: var(--spacing-2xl);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: var(--spacing-sm) var(--spacing-lg);
		border: 1px solid var(--color-text);
		border-radius: var(--radius);
		background: var(--color-text);
		color: var(--color-bg);
		font-size: var(--font-size-sm);
		font-weight: 800;
		text-decoration: none;
	}

	.button.secondary {
		background: transparent;
		color: var(--color-text);
	}

	.button:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.empty-state {
		padding-block: var(--spacing-4xl);
		color: var(--color-muted);
		text-align: center;
	}

	.empty-state .button {
		margin-top: var(--spacing-lg);
	}

	@media (max-width: 960px) {
		.pieces-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.gallery-header h1 {
			font-size: var(--font-size-3xl);
		}

		.pieces-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
