---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	summary?: string;
	featuredImage?: unknown;
	href: string;
	categories?: string[];
	tags?: string[];
}

const { title, summary, featuredImage, href, categories = [], tags = [] } =
	Astro.props;
const visibleTerms = [...categories, ...tags].slice(0, 4);
const image = featuredImage as MediaValue | string | null | undefined;
---

<article class="piece-card">
	<a href={href} class="card-link">
		<div class="card-image">
			{image && <Image image={image} />}
		</div>
		<div class="card-content">
			{
				visibleTerms.length > 0 && (
					<p class="card-meta">{visibleTerms.join(" / ")}</p>
				)
			}
			<h2 class="card-title">{title}</h2>
			{summary && <p class="card-summary">{summary}</p>}
		</div>
	</a>
</article>

<style>
	.piece-card {
		position: relative;
	}

	.card-link {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		color: inherit;
		text-decoration: none;
	}

	.card-image {
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.card-image img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		transition: transform var(--transition-slow);
	}

	.piece-card:hover .card-image img {
		transform: scale(1.025);
	}

	.card-content {
		display: grid;
		gap: var(--spacing-xs);
	}

	.card-meta {
		color: var(--color-muted);
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.card-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		transition: color var(--transition-fast);
	}

	.piece-card:hover .card-title {
		color: var(--color-brand);
	}

	.card-summary {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: var(--leading-normal);
	}
</style>
